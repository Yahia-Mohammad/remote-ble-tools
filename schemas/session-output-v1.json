{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remoteble.dev/schemas/session-output-v1.json",
  "title": "RemoteBLE persistent session output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "timestamp", "sequence", "id", "data"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "enum": ["session.ready", "command.accepted", "command.result", "command.error", "stream.started", "stream.event", "stream.closed", "session.closed"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "maxLength": 128 },
    "streamId": { "type": "integer", "minimum": 1 },
    "data": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "session.ready" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/ready" } } } },
    { "if": { "properties": { "type": { "const": "command.accepted" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/accepted" } } } },
    { "if": { "properties": { "type": { "const": "command.error" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/error" } } } },
    { "if": { "properties": { "type": { "const": "command.result" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/result" } } } },
    { "if": { "properties": { "type": { "const": "stream.started" } } }, "then": { "required": ["streamId"], "properties": { "data": { "$ref": "#/$defs/started" } } } },
    { "if": { "properties": { "type": { "const": "stream.event" } } }, "then": { "required": ["streamId"], "properties": { "data": { "$ref": "#/$defs/streamEvent" } } } },
    { "if": { "properties": { "type": { "const": "stream.closed" } } }, "then": { "required": ["streamId"], "properties": { "data": { "$ref": "#/$defs/closed" } } } },
    { "if": { "properties": { "type": { "const": "session.closed" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/sessionClosed" } } } }
  ],
  "$defs": {
    "ready": { "type": "object", "additionalProperties": false, "required": ["sessionId", "capabilities", "operatorScope"], "properties": { "sessionId": { "type": "string", "minLength": 1 }, "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "operatorScope": { "type": "boolean" } } },
    "accepted": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "type": "string" } } },
    "error": { "type": "object", "additionalProperties": false, "required": ["exitCode", "message"], "properties": { "exitCode": { "type": "integer", "minimum": 1, "maximum": 255 }, "message": { "type": "string" }, "errorKind": { "type": "string" }, "gattStatus": { "type": "integer" }, "holder": { "type": "object", "additionalProperties": false, "required": ["principal"], "properties": { "principal": { "type": "string" }, "clientId": { "type": "string" } } } } },
    "result": { "oneOf": [ { "$ref": "#/$defs/status" }, { "$ref": "#/$defs/slots" }, { "$ref": "#/$defs/bytes" }, { "$ref": "#/$defs/write" }, { "$ref": "#/$defs/stopped" }, { "$ref": "#/$defs/closedCommand" } ] },
    "status": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "uptimeMs", "operatorScope", "connectedClients", "otherLeases", "slots", "settings", "leases"], "properties": { "agentInfo": { "type": "string" }, "protocolVersion": { "type": "integer" }, "uptimeMs": { "type": "integer", "minimum": 0 }, "operatorScope": { "type": "boolean" }, "connectedClients": { "type": "integer", "minimum": 0 }, "otherLeases": { "type": "integer", "minimum": 0 }, "slots": { "$ref": "#/$defs/slots" }, "settings": { "type": "object", "additionalProperties": false, "required": ["transportGraceMs", "leaseGraceMs", "exclusiveByDefault", "scanConcurrency", "strictIdentifiers", "writePolicyEnforced"], "properties": { "transportGraceMs": { "type": "integer", "minimum": 0 }, "leaseGraceMs": { "type": "integer", "minimum": 0 }, "exclusiveByDefault": { "type": "boolean" }, "scanConcurrency": { "type": "string" }, "strictIdentifiers": { "type": "boolean" }, "writePolicyEnforced": { "type": "boolean" } } }, "leases": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["handle", "mine", "connected", "inGrace"], "properties": { "handle": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "holder": { "type": "string" }, "mine": { "type": "boolean" }, "connected": { "type": "boolean" }, "inGrace": { "type": "boolean" }, "remainingGraceMs": { "type": "integer", "minimum": 0 } } } } } },
    "slots": { "type": "object", "additionalProperties": false, "required": ["free", "total"], "properties": { "free": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 } } },
    "bytes": { "type": "object", "additionalProperties": false, "required": ["hex", "base64", "length"], "properties": { "hex": { "type": "string" }, "base64": { "type": "string" }, "length": { "type": "integer", "minimum": 0 } } },
    "write": { "type": "object", "additionalProperties": false, "required": ["handle", "length", "withResponse"], "properties": { "handle": { "type": "string", "minLength": 1 }, "length": { "type": "integer", "minimum": 0 }, "withResponse": { "type": "boolean" } } },
    "stopped": { "type": "object", "additionalProperties": false, "required": ["streamId", "stopped"], "properties": { "streamId": { "type": "integer", "minimum": 1 }, "stopped": { "const": true } } },
    "closedCommand": { "type": "object", "additionalProperties": false, "required": ["closed"], "properties": { "closed": { "const": true } } },
    "started": { "type": "object", "additionalProperties": false, "required": ["command"], "properties": { "command": { "enum": ["scan", "observe"] } } },
    "streamEvent": { "oneOf": [ { "$ref": "#/$defs/advertisement" }, { "$ref": "#/$defs/bytes" } ] },
    "advertisement": { "type": "object", "additionalProperties": false, "required": ["handle", "rssi", "serviceUuids"], "properties": { "handle": { "type": "string", "minLength": 1 }, "name": { "type": "string" }, "rssi": { "type": "integer" }, "serviceUuids": { "type": "array", "items": { "type": "string" } } } },
    "closed": { "type": "object", "additionalProperties": false, "required": ["count", "reason"], "properties": { "count": { "type": "integer", "minimum": 0 }, "reason": { "enum": ["count", "complete", "timeout", "stopped", "error", "slow-consumer"] } } },
    "sessionClosed": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string", "minLength": 1 } } }
  }
}
